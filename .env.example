# Flask session/flash-message signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Gmail SMTP (works the same for a free @gmail.com account or Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# App Password generated from the SMTP_USERNAME account (requires 2-Step Verification)
SMTP_APP_PASSWORD=

# Optional: where contact-form submissions are delivered. Defaults to SMTP_USERNAME.
CONTACT_RECIPIENT=
